# Copy this file to .env, fill in the key, and restart Liora.
DEEPSEEK_API_KEY=

# Current official OpenAI-compatible endpoint and recommended fast model.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30

# Optional web verification. Without this key Liora still uses model knowledge,
# but will clearly say that current or exact facts were not searched online.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_SECONDS=15
TAVILY_MAX_RESULTS=4

# Runtime shell. Leave empty for the Windows/macOS/Linux desktop companion.
# Use "device" in a dedicated Linux hardware image.
LIORA_RUNTIME=

# Use a normal 800x480 window while developing the hardware interface.
LIORA_DEVICE_WINDOWED=0

# Optional weather context. Weather stays disabled until both coordinates exist.
LIORA_WEATHER_ENABLED=1
LIORA_WEATHER_LOCATION=
LIORA_WEATHER_LATITUDE=
LIORA_WEATHER_LONGITUDE=
